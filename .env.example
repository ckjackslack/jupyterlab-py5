# Copy to .env and adjust. All values are optional.

# Host port and interface JupyterLab is published on.
JUPYTER_HOST_PORT=8888
JUPYTER_BIND=127.0.0.1

# Fixed login token; leave empty to get a random one printed in `docker compose logs`.
JUPYTER_TOKEN=

# Virtual display used for sketch windows inside the container (WIDTHxHEIGHTxDEPTH).
PY5_SCREEN=1280x1024x24

# UID of the container user; match your host UID (`id -u`) so ./notebooks stays writable.
NB_UID=1000
